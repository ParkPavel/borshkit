{
  "schemaVersion": 1,
  "product": "borshkit",
  "folder": "borshkit",
  "privacy": "moderate",
  "autopilot": false,
  "silenceSeconds": 60,
  "trustedAgent": null,
  "executors": {
    "claude": {
      "kind": "claude-cli",
      "command": "claude",
      "provider": "anthropic",
      "dataPolicy": "unknown",
      "structuredOutput": "json_schema",
      "modalities": {
        "output": [
          "text",
          "code"
        ]
      }
    },
    "codex": {
      "kind": "codex-cli",
      "command": "codex",
      "provider": "openai",
      "dataPolicy": "unknown",
      "structuredOutput": "json_schema",
      "modalities": {
        "output": [
          "text",
          "code",
          "image"
        ]
      }
    },
    "mistral-free": {
      "kind": "openai-compat",
      "provider": "mistral",
      "service": "mistral",
      "baseUrl": "https://api.mistral.ai/v1",
      "model": "mistral-medium-latest",
      "apiKeyEnv": "MISTRAL_API_KEY",
      "dataPolicy": "trains",
      "structuredOutput": "json_mode",
      "modalities": {
        "output": [
          "text",
          "code"
        ]
      }
    }
  },
  "pools": {},
  "acceptance": {
    "modelTrust": {}
  }
}
