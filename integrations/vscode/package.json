{
  "name": "borshkit-workspace",
  "displayName": "Borshkit — команда и состояние",
  "publisher": "borshkit",
  "version": "0.12.0",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.cjs",
  "activationEvents": ["onCommand:borshkit.setup", "onCommand:borshkit.status", "onCommand:borshkit.team"],
  "capabilities": {"untrustedWorkspaces":{"supported":false}},
  "contributes": {
    "commands": [
      { "command": "borshkit.setup", "title": "Borshkit: настройка команды" },
      { "command": "borshkit.status", "title": "Borshkit: состояние работ" },
      { "command": "borshkit.team", "title": "Borshkit: роли и ресурсы" }
    ],
    "configuration": {"title":"Borshkit","properties":{
      "borshkit.nodePath":{"type":"string","default":"node","description":"Node.js 22+"}
    }}
  }
}
