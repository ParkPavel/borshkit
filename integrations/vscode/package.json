{
  "name": "borshkit-workspace",
  "displayName": "Borshkit — команда и состояние",
  "publisher": "borshkit",
  "version": "0.13.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:borshkit.setup",
    "onCommand:borshkit.status",
    "onCommand:borshkit.team",
    "onCommand:borshkit.nativeStart",
    "onCommand:borshkit.nativeCancel",
    "onCommand:borshkit.nativeStatus",
    "onCommand:borshkit.workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "borshkit.workspace",
        "title": "Borshkit: открыть рабочее пространство"
      },
      {
        "command": "borshkit.setup",
        "title": "Borshkit: настройка команды"
      },
      {
        "command": "borshkit.status",
        "title": "Borshkit: состояние работ"
      },
      {
        "command": "borshkit.team",
        "title": "Borshkit: роли и ресурсы"
      },
      {
        "command": "borshkit.nativeStart",
        "title": "Borshkit: нативный запуск задачи"
      },
      {
        "command": "borshkit.nativeCancel",
        "title": "Borshkit: остановить нативную работу"
      },
      {
        "command": "borshkit.nativeStatus",
        "title": "Borshkit: состояние нативной работы"
      }
    ],
    "configuration": {
      "title": "Borshkit",
      "properties": {
        "borshkit.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js 22+"
        }
      }
    }
  }
}
