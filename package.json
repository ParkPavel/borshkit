{
  "name": "borshkit",
  "version": "0.11.1",
  "description": "Borshkit — Modular AI Workspace: AI agents work, evidence bound to the exact file state decides acceptance, and whatever cannot be proven comes to you as a short manual checklist.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "borshkit": "bin/borshkit.mjs",
    "borsch": "bin/borshkit.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ParkPavel/borshkit.git"
  },
  "license": "Apache-2.0",
  "author": "Pavel Park",
  "files": [
    "bin",
    "core",
    "roles",
    "packs",
    "skills",
    "hooks",
    ".claude-plugin",
    "docs",
    "examples",
    "third-party.json",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTORS-REFERENCES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "assets",
    "library",
    "README.en.md",
    "README.de.md",
    "README.ko.md",
    "README.zh-TW.md",
    "README.fr.md",
    "scripts/library.mjs",
    "scripts/diagrams.mjs"
  ],
  "keywords": [
    "ai-agents",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "agentic-workflow",
    "acceptance-testing",
    "evidence",
    "multi-agent",
    "llm",
    "obsidian",
    "knowledge-graph",
    "sqlite",
    "wikilinks",
    "agent-skills",
    "frontend",
    "design-engineering",
    "accessibility",
    "ios",
    "privacy",
    "developer-tools"
  ],
  "homepage": "https://github.com/ParkPavel/borshkit#readme",
  "bugs": {
    "url": "https://github.com/ParkPavel/borshkit/issues"
  }
}
